# ==============================================================================
# E-Commerce Data Pipeline & GenAI Platform - Environment Configuration Template
# (The Twelve-Factor App - Factor III: Store config in the environment)
# ==============================================================================
# Instructions: Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
# Set to 'true' in production (GCP Cloud Run / Composer) or 'false' for 100% free local execution.
USE_BIGQUERY=false

# Google Cloud Project ID and Default Region
GCP_PROJECT=anna-ml-pipeline
GOOGLE_CLOUD_PROJECT=anna-ml-pipeline
GCP_LOCATION=us-central1

# Google Cloud Storage Bucket for ML artifacts and pipeline snapshots
GCS_BUCKET=anna-ml-pipeline-bucket

# Path to GCP Service Account JSON key (optional if using 'gcloud auth application-default login')
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ------------------------------------------------------------------------------
# 2. Database & Feature Store (PostgreSQL / pgvector / Firestore)
# ------------------------------------------------------------------------------
# Local Docker or Cloud SQL PostgreSQL credentials
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Machine Learning & Feature Lineage Tracking
# ------------------------------------------------------------------------------
# MLflow Tracking Server URI (local directory or remote GCS / Cloud Run tracking server)
MLFLOW_TRACKING_URI=file:./mlruns

# Data & Feature Store Version Lineage Identifiers
RFM_FEATURE_VERSION=rfm_v1
CHURN_FEATURE_VERSION=churn_v2
TWO_TOWER_VERSION=two_tower_v1

# ------------------------------------------------------------------------------
# 4. API & Service Runtime
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
TEST_DRIFT_ACTIVE=false
# Logging format: 'text' for local human-readable development, 'json' for Google Cloud Logging
LOG_FORMAT=text
LOG_LEVEL=INFO
